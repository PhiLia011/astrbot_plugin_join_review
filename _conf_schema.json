  "desensitize": {
    "description": "信息脱敏",
    "type": "bool",
    "hint": "对敏感信息进行脱敏处理，一般用不到，正常使用时没有敏感信息",
    "default": true
  },
  "mystery_url": {
    "description": "拓展配置项",
    "hint": "无需填写，仅供开发人员使用",
    "type": "string",
    "default": ""
  },
  "mystery_cookies": {
    "description": "cookies",
